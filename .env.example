# Скопируйте в .env и заполните. .env НЕ коммитить.
POSTGRES_PASSWORD=change-me
# Токен бота из кабинета MAX (старый токен из прежнего кода считать скомпрометированным — перевыпустите!)
BOT_TOKEN=
# Случайная строка: openssl rand -hex 32  (секрет между ботом и backend)
SERVICE_KEY=
# Коды доступа для ролей (придумайте новые)
ADMIN_CODE=
CURATOR_CODE=
# Публичный HTTPS-адрес фронтенда (для кнопки «Открыть карту» в боте)
WEBAPP_URL=
WEB_PORT=8080
# 1 — разрешить заголовок X-Dev-User-Id / ?dev_user=ID для локальной отладки. В проде 0!
DEV_MODE=0
HEXES_PER_CLASS=6
INCOME_TZ=Asia/Vladivostok
