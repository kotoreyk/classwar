# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- Для просмотра сайта и API достаточно значений по умолчанию ---
POSTGRES_PASSWORD=battle
WEB_PORT=8080

# 1 — войти без MAX через ?dev_user=ID (только для локальной проверки, в проде 0)
DEV_MODE=0

# Коды для ролей куратора и администратора. Пока пусты, эти роли недоступны.
ADMIN_CODE=
CURATOR_CODE=

# --- Нужно только для бота ---
# Токен бота из кабинета MAX
BOT_TOKEN=
# Общий секрет бота и backend: openssl rand -hex 32
SERVICE_KEY=
# Публичный HTTPS-адрес сайта для кнопки «Открыть карту»
WEBAPP_URL=

# --- Необязательно ---
HEXES_PER_CLASS=6
INCOME_TZ=Asia/Vladivostok
# Для публикации образов: имя на Docker Hub и версия
REGISTRY=battle
TAG=latest
